{
  "name": "oh-my-shokz",
  "version": "0.1.7",
  "description": "YouTube to MP3 helper for Shokz transfer workflow",
  "main": "main.js",
  "author": "noahgim",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --mac dmg"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.noahgim.ohmyshokz",
    "productName": "OhMyShokz",
    "afterPack": "build/after-pack.js",
    "mac": {
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        "dmg"
      ]
    },
    "files": [
      "main.js",
      "bundled-tool-path.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ]
  }
}
